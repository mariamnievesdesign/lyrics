<Window x:Class="Letras.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Letras" Width="420" Height="260" MinWidth="260" MinHeight="150"
        WindowStyle="None" Background="Transparent"
        Topmost="True" ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Botón redondo translúcido -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="#1FFFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Tarjeta: el vidrio lo pone Windows; aquí solo un tinte muy suave -->
    <Border x:Name="Card" Background="#0AFFFFFF">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado: canción + controles (aparecen al pasar el mouse) -->
                <Grid Grid.Row="0" Margin="18,12,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="TrackInfoPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TitleText" Foreground="#F2FFFFFF" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText" Foreground="#99FFFFFF" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel x:Name="ControlsPanel" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Opacity="0" Margin="8,0,0,0">
                        <Button Style="{StaticResource GlassButton}" Content="−" Click="Earlier_Click"
                                ToolTip="La letra va adelantada: retrásala 0.5 s" />
                        <TextBlock x:Name="OffsetText" Foreground="#B3FFFFFF" FontSize="11" MinWidth="38"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" Text="0.0 s" />
                        <Button Style="{StaticResource GlassButton}" Content="+" Click="Later_Click"
                                ToolTip="La letra va atrasada: adelántala 0.5 s" />
                        <Button Style="{StaticResource GlassButton}" Content="A" FontSize="10" Margin="10,0,0,0"
                                Click="Smaller_Click" ToolTip="Letra más pequeña" />
                        <Button Style="{StaticResource GlassButton}" Content="A" FontSize="14"
                                Click="Bigger_Click" ToolTip="Letra más grande" />
                        <Button Style="{StaticResource GlassButton}" Content="◐" FontSize="13" Margin="10,0,0,0"
                                Click="Glass_Click" ToolTip="Transparencia del fondo" />
                        <Button Style="{StaticResource GlassButton}" Content="✕" Margin="3,0,0,0"
                                Click="Close_Click" ToolTip="Cerrar" />
                    </StackPanel>
                </Grid>

                <!-- Letra -->
                <Grid Grid.Row="1" x:Name="Viewport" ClipToBounds="True" Margin="16,6,16,12">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="0.18" />
                            <GradientStop Color="#FF000000" Offset="0.82" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.OpacityMask>

                    <!-- Canvas: no recorta la letra, así puede deslizarse libremente -->
                    <Canvas x:Name="LinesCanvas">
                        <StackPanel x:Name="LinesPanel">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="Scroll" />
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.45" Color="Black" />
                            </StackPanel.Effect>
                        </StackPanel>
                    </Canvas>

                    <TextBlock x:Name="StatusText" Foreground="#B3FFFFFF" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
