<Window x:Class="Letras.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <!-- Botón redondo translúcido -->
            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3,0,0,0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#E6FFFFFF" />
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado: canción + controles (aparecen al pasar el mouse) -->
        <Grid Grid.Row="0" Margin="18,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TrackInfoPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TitleText" Foreground="#F2FFFFFF" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Foreground="#A6FFFFFF" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="ControlsPanel" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Opacity="0" Margin="8,0,0,0">
                <Button Style="{StaticResource GlassButton}" Content="−" Click="Earlier_Click"
                        ToolTipService.ToolTip="La letra va adelantada: retrásala 0.5 s" />
                <TextBlock x:Name="OffsetText" Foreground="#B3FFFFFF" FontSize="11" MinWidth="38"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" Text="0.0 s" />
                <Button Style="{StaticResource GlassButton}" Content="+" Click="Later_Click"
                        ToolTipService.ToolTip="La letra va atrasada: adelántala 0.5 s" />
                <Button Style="{StaticResource GlassButton}" Content="A" FontSize="10" Margin="10,0,0,0"
                        Click="Smaller_Click" ToolTipService.ToolTip="Letra más pequeña" />
                <Button Style="{StaticResource GlassButton}" Content="A" FontSize="14"
                        Click="Bigger_Click" ToolTipService.ToolTip="Letra más grande" />
                <Button Style="{StaticResource GlassButton}" Content="◐" FontSize="13" Margin="10,0,0,0"
                        Click="Glass_Click" ToolTipService.ToolTip="Transparencia del fondo" />
                <Button Style="{StaticResource GlassButton}" Content="✕" Click="Close_Click"
                        ToolTipService.ToolTip="Cerrar" />
            </StackPanel>
        </Grid>

        <!-- Letra -->
        <Grid Grid.Row="1" x:Name="Viewport" Margin="16,6,16,12">
            <!-- Canvas: no recorta la letra, así puede deslizarse libremente -->
            <Canvas x:Name="LinesCanvas">
                <StackPanel x:Name="LinesPanel">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="Scroll" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </Canvas>

            <TextBlock x:Name="StatusText" Foreground="#CCFFFFFF" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
